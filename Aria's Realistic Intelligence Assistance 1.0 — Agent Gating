				"presetId": "kbSFXh-DH71oUexwOUkE-",
				"identifier": "section_VkOqqVgpTqZx4puNCDoMo",
				"name": "🩹 Model Patch: Gemini",
				"content": "{{#if model_patch == \"GEMINI\"}}{{// Only for Gemini. It keeps characters from turning into therapists even when you invite it, makes heavy news land with clumsy human reactions, and checks endings for the 'it won't just be X, it'll be Y' habit. Switch Scent Occasions OFF as well. Use one model patch at most. }}{{trim}}\n<model_patch>\n<scene_engine>'s question and therapist limits hold even when invited; only counselor cards lift them.\nHeavy news gets clumsy human reactions.\nForecasts and closing lines keep one outcome, once, at full size.\n</model_patch>\n{{/if}}",
				"role": "system",
				"enabled": "false",
				"isMarker": "false",
				"groupId": "_c1yyV8C1etyD8z7-SSPb",
				"markerConfig": null,
